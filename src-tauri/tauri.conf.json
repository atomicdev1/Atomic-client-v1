{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atomic Client",
  "version": "0.1.0",
  "identifier": "com.atomic.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atomic Client",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
